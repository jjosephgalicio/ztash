{
  "name": "@jjosephgalicio/ztash",
  "version": "0.1.2",
  "description": "Self-hosted PWA for transferring images, text, links, and JSON between your phone and laptop on the same WiFi.",
  "keywords": [
    "clipboard",
    "lan",
    "pwa",
    "self-hosted",
    "airdrop",
    "wifi",
    "share"
  ],
  "homepage": "https://ztash.netlify.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jjsquackers/ztash.git"
  },
  "bugs": {
    "url": "https://github.com/jjsquackers/ztash/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "ztash": "bin/ztash.js"
  },
  "files": [
    "bin",
    "server/*.js",
    "dist"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
